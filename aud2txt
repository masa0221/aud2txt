#!/usr/bin/env bash
set -u

export LANG="${LANG:-ja_JP.UTF-8}"
export LC_ALL="${LC_ALL:-ja_JP.UTF-8}"

# Colors (only when stdout is a TTY)
if [[ -t 1 ]]; then
  R='\033[0;31m'
  G='\033[0;32m'
  Y='\033[0;33m'
  C='\033[0;36m'
  X='\033[0m'
else
  R= G= Y= C= X=
fi

recursive=1
dst="outputs"
dst_specified=0

# Option parsing
while [[ $# -gt 0 ]]; do
  case "$1" in
    -r|--recursive)
      recursive=1
      shift
      ;;
    -R|--no-recursive)
      recursive=0
      shift
      ;;
    -o|--output)
      dst="$2"
      dst_specified=1
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [options] input(file|directory) [output_directory]"
      echo ""
      echo "Options:"
      echo "  -r, --recursive       Recursive search in directory (default)"
      echo "  -R, --no-recursive     Top-level only"
      echo "  -o, --output DIR      Output directory"
      echo "  -h, --help            Show this help"
      echo ""
      echo "Examples:"
      echo "  $0 audio.mp3                    # Single file, output to outputs/"
      echo "  $0 ./audios                    # Directory (recursive)"
      echo "  $0 -R -o out ./audios          # No recursive, output to out/"
      exit 0
      ;;
    -*)
      echo -e "${R}Unknown option: $1${X}"
      echo "  Use -h for help"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

input="${1:-}"
if [[ $dst_specified -eq 0 && -n "${2:-}" ]]; then
  dst="$2"
fi

if [[ -z "$input" ]]; then
  echo "Usage: $0 [options] input(file|directory) [output_directory]"
  echo "  Use -h for help"
  exit 1
fi

if [[ ! -e "$input" ]]; then
  echo -e "${R}Input does not exist: $input${X}"
  exit 1
fi

# Check required commands (ffmpeg for format conversion if needed; whisper for transcription)
for cmd in ffmpeg; do
  if ! command -v "$cmd" &>/dev/null; then
    echo -e "${R}Error: Required command not found: $cmd${X}"
    echo -e "  Install ffmpeg (e.g. brew install ffmpeg)"
    exit 1
  fi
done

# Whisper is optional for now - if not found, use placeholder
WHISPER_AVAILABLE=0
if command -v whisper &>/dev/null; then
  WHISPER_AVAILABLE=1
fi

mkdir -p "$dst"
dst="$(cd "$dst" && pwd)"

if [[ -f "$input" ]]; then
  src_base="$(cd "$(dirname "$input")" && pwd)"
  input_file="$src_base/$(basename "$input")"
else
  src_base="$(cd "$input" && pwd)"
  input_file=""
fi

log_dir="$dst/_logs"
mkdir -p "$log_dir"

failed_list="$log_dir/failed.txt"
failed_detail="$log_dir/failed_detail.log"
skipped_list="$log_dir/skipped.txt"
summary="$log_dir/summary.txt"

: > "$failed_list"
: > "$failed_detail"
: > "$skipped_list"
: > "$summary"

ok=0
fail=0
skip=0
missing=0
total=0

transcribe_one() {
  local f="$1"
  local rel out errfile

  total=$((total + 1))

  if [[ ! -f "$f" ]]; then
    missing=$((missing + 1))
    printf 'MISSING: %s\n' "$f" >> "$failed_list"
    return 0
  fi

  rel="${f#$src_base/}"
  rel="${rel#/}"
  out="$dst/${rel%.*}.txt"
  mkdir -p "$(dirname "$out")"

  if [[ -f "$out" ]]; then
    skip=$((skip + 1))
    printf '%s\n' "$f" >> "$skipped_list"
    return 0
  fi

  printf "${C}Transcribing${X}: %s\n" "$f"
  errfile="$log_dir/err.$$.txt"
  : > "$errfile"

  if [[ $WHISPER_AVAILABLE -eq 1 ]]; then
    # Use Whisper CLI (openai-whisper): outputs to --output_dir with base.txt
    local tmpdir base
    tmpdir="$(mktemp -d)"
    base="$(basename "$f" | sed 's/\.[^.]*$//')"
    if whisper "$f" --output_dir "$tmpdir" --output_format txt </dev/null >>"$errfile" 2>&1; then
      if [[ -f "$tmpdir/${base}.txt" ]]; then
        mv "$tmpdir/${base}.txt" "$out"
      else
        local txtfile
        txtfile="$(find "$tmpdir" -name "*.txt" -type f | head -1)"
        [[ -n "$txtfile" && -f "$txtfile" ]] && mv "$txtfile" "$out"
      fi
    fi
    rm -rf "$tmpdir"
  else
    # Placeholder: create .txt with note (for structure testing / CI)
    echo "[Placeholder] Install Whisper for transcription: uv tool install openai-whisper (or pip install openai-whisper)" > "$out"
  fi

  if [[ -f "$out" ]]; then
    ok=$((ok + 1))
  else
    fail=$((fail + 1))
    printf 'FAIL: %s\n' "$f" >> "$failed_list"
    {
      echo "=========="
      echo "FAIL FILE: $f"
      echo "OUT FILE : $out"
      echo "--- last 30 lines ---"
      tail -n 30 "$errfile"
      echo
    } >> "$failed_detail"
  fi

  rm -f "$errfile"
}

if [[ -n "$input_file" ]]; then
  transcribe_one "$input_file"
else
  if [[ "$recursive" -eq 1 ]]; then
    while IFS= read -r -d '' f; do
      [[ -z "$f" ]] && continue
      transcribe_one "$f"
    done < <(find "$src_base" -type f \( -name "*.mp3" -o -name "*.wav" -o -name "*.m4a" -o -name "*.flac" -o -name "*.ogg" -o -name "*.webm" \) -print0)
  else
    while IFS= read -r -d '' f; do
      [[ -z "$f" ]] && continue
      transcribe_one "$f"
    done < <(find "$src_base" -maxdepth 1 -type f \( -name "*.mp3" -o -name "*.wav" -o -name "*.m4a" -o -name "*.flac" -o -name "*.ogg" -o -name "*.webm" \) -print0)
  fi
fi

{
  echo "SRC : $src_base"
  echo "DST : $dst"
  echo "TOTAL  : $total"
  echo -e "OK     : ${G}$ok${X}"
  echo -e "SKIP   : ${Y}$skip${X}"
  echo -e "MISSING: ${Y}$missing${X}"
  echo -e "FAIL   : ${R}$fail${X}"
  echo
  echo "skipped       : $skipped_list"
  echo "failed list   : $failed_list"
  echo "failed detail : $failed_detail"
} | tee "$summary"

echo -e "${G}Done${X}"
